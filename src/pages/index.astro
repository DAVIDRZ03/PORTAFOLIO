---
import { projects } from '../data/projects.js';
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>David | Frontend Developer</title>
    <meta name="description" content="Portafolio de desarrollo frontend especializado en aplicaciones web interactivas y consumo de APIs." />
  <body class="bg-slate-950 text-slate-100 min-h-screen antialiased selection:bg-indigo-500 selection:text-white">
    <main class="max-w-4xl mx-auto px-6 py-16 flex flex-col gap-20">
      
      <!-- HERO SECTION -->
      <section class="flex flex-col gap-6">
        <span class="text-sm font-semibold tracking-wider text-indigo-400 uppercase">Frontend Developer</span>
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-white">
          Hola, soy David. Construyo interfaces web rápidas y modernas.
        </h1>
        <p class="text-lg text-slate-400 max-w-2xl leading-relaxed">
          Especializado en la creación de aplicaciones web centradas en la experiencia de usuario, integración de APIs REST y buenas prácticas de desarrollo.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a 
            href="https://github.com/DAVIDRZ03" 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-slate-700 text-sm font-medium transition-colors"
          >
            GitHub
          </a>
          <a 
            href="mailto:tu-correo@gmail.com" 
            class="px-5 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium transition-colors shadow-lg shadow-indigo-500/20"
          >
            Contáctame
          </a>
        </div>
      </section>

      <!-- PROYECTOS DESTACADOS -->
      <section class="flex flex-col gap-8">
        <div class="flex items-center gap-4">
          <h2 class="text-2xl font-bold text-white">Proyectos Destacados</h2>
          <div class="h-px bg-slate-800 flex-1"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {projects.map((project) => (
            <article class="p-6 rounded-xl bg-slate-900/60 border border-slate-800/80 hover:border-indigo-500/50 transition-all flex flex-col justify-between group">
              <div>
                <h3 class="text-xl font-bold text-white group-hover:text-indigo-400 transition-colors">
                  {project.title}
                </h3>
                <p class="mt-3 text-slate-400 text-sm leading-relaxed">
                  {project.description}
                </p>
                
                <div class="flex flex-wrap gap-2 mt-4">
                  {project.tags.map((tag) => (
                    <span class="text-xs px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 font-mono">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <div class="flex items-center gap-4 mt-6 pt-4 border-t border-slate-800/60">
                <a 
                  href={project.demoUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-sm font-medium text-white hover:text-indigo-400 transition-colors flex items-center gap-1"
                >
                  Ver Demo &rarr;
                </a>
                <a 
                  href={project.repoUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-sm font-medium text-slate-400 hover:text-white transition-colors"
                >
                  Código Fuente
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- HABILIDADES -->
      <section class="flex flex-col gap-6">
        <div class="flex items-center gap-4">
          <h2 class="text-2xl font-bold text-white">Habilidades Técnicas</h2>
          <div class="h-px bg-slate-800 flex-1"></div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
          <div class="p-4 rounded-lg bg-slate-900/40 border border-slate-800">
            <span class="text-indigo-400 block font-semibold mb-1">Frontend</span>
            <span class="text-slate-300">JavaScript, React, HTML5, CSS3</span>
          </div>
          <div class="p-4 rounded-lg bg-slate-900/40 border border-slate-800">
            <span class="text-indigo-400 block font-semibold mb-1">Estilos</span>
            <span class="text-slate-300">Tailwind CSS, Responsive Design</span>
          </div>
          <div class="p-4 rounded-lg bg-slate-900/40 border border-slate-800">
            <span class="text-indigo-400 block font-semibold mb-1">Herramientas</span>
            <span class="text-slate-300">Vite, Git, GitHub, VS Code</span>
          </div>
          <div class="p-4 rounded-lg bg-slate-900/40 border border-slate-800">
            <span class="text-indigo-400 block font-semibold mb-1">Despliegue</span>
            <span class="text-slate-300">Vercel, REST APIs</span>
          </div>
        </div>
      </section>

      <!-- FOOTER -->
      <footer class="text-center text-xs text-slate-500 pt-8 border-t border-slate-900">
        <p>© {new Date().getFullYear()} David. Construido con Astro y Tailwind CSS.</p>
      </footer>

    </main>
  </body>
</html>